  "blacklist": [
    {
      "id": "bare-recomputer-j",
      "pattern": "reComputer\\s+J(?![0-9A-Za-z])",
      "severity": "error",
      "message": "'reComputer J' 不是产品名。Orin Nano 写 reComputer J30 系列，Orin NX 写 reComputer J40 系列"
    },
    {
      "id": "bare-recomputer-r",
      "pattern": "reComputer\\s+R(?![0-9A-Za-z])",
      "severity": "error",
      "message": "'reComputer R' 不是产品名。Hailo 机型写 reComputer R2000 系列，Pi 4 级写 reComputer R10 系列"
    },
    {
      "id": "recomputer-r20-r21-bare",
      "pattern": "reComputer\\s+R2[01](?![0-9])",
      "severity": "error",
      "message": "'reComputer R20'/'reComputer R21' 不是对外产品名，写 'reComputer R2000 系列' 或完整型号（R2135-12）"
    },
    {
      "id": "sensecap-r1000",
      "pattern": "SenseCAP\\s+R1[01]0[0-9]",
      "severity": "error",
      "message": "R1000/R1100 属于 reComputer，不是 SenseCAP。写 reComputer R10 系列"
    },
    {
      "id": "recomputer-r-hailo",
      "pattern": "reComputer\\s+R\\s*[（(]\\s*Hailo",
      "severity": "error",
      "message": "'reComputer R (Hailo)' 不是产品名，写 reComputer R2000 系列（Hailo-8）"
    }
  ],
  "bench_only_names": [
    {
      "id": "bench-radxa",
      "pattern": "\\bRadxa\\b",
      "message": "Radxa 是台架板，不是交付设备。RK3588/RK3576 写 reComputer RK3588 / RK3576 系列"
    },
    {
      "id": "bench-rock5t",
      "pattern": "\\bROCK\\s*5[TAB]?\\b",
      "message": "ROCK 5 系列是台架板，不是交付设备。写 reComputer RK3588 系列"
    },
    {
      "id": "bench-lubancat",
      "pattern": "\\bLubanCat\\b",
      "message": "LubanCat 是台架板，不是交付设备。写 reComputer RK3576 系列"
    },
    {
      "id": "bench-fleet-id",
      "pattern": "\\b(harvest-pi|cat-remote|orin-nx|orin-nano|wsl2?-local|seeed-pi)\\b",
      "message": "fleet 设备名是内部台架标识，不能出现在对外文本里"
    },
    {
      "id": "bench-pi5-delivery",
      "pattern": "Raspberry\\s+Pi\\s*5|树莓派\\s*5",
      "message": "Raspberry Pi 5 是台架机，不是交付设备。同主控写 reComputer R2000 系列"
    },
    {
      "id": "bench-pi4-delivery",
      "pattern": "Raspberry\\s+Pi\\s*4|树莓派\\s*4",
      "message": "Raspberry Pi 4 是台架机，不是交付设备。同主控写 reComputer R10 系列或 reTerminal DM"
    }
  ],
  "bench_allow_paths": [
    "/docs/",
    "/runs/",
    "/bench/",
    "evaluation",
    "internal-status",
    "run-record",
    "ATTRIBUTION"
  ],
  "bench_allow_markers": [
    "lint:bench-ok"
  ],
  "cross_checks": [
    {
      "id": "j30-orin-nx",
      "left": "(?<![A-Za-z0-9])J30(?:\\d{1,2}B?)?(?![\\w-])|reComputer\\s+J30\\s*(系列|Series)",
      "right": "Orin\\s+NX",
      "severity": "error",
      "message": "J30 系列装的是 Jetson Orin Nano，不是 Orin NX。Orin NX 对应 J40 系列",
      "unless": "\\bJ40\\b|\\bJ401[12]B?\\b",
      "unless_note": "同一格里同时列出 J40 时，Orin NX 归 J40，不算错配"
    },
    {
      "id": "j40-orin-nano",
      "left": "(?<![A-Za-z0-9])J40(?:\\d{1,2}B?)?(?![\\w-])|reComputer\\s+J40\\s*(系列|Series)",
      "right": "Orin\\s+Nano",
      "severity": "error",
      "message": "J40 系列装的是 Jetson Orin NX，不是 Orin Nano。Orin Nano 对应 J30 系列",
      "unless": "\\bJ30\\b|\\bJ301[01]B?\\b",
      "unless_note": "同一格里同时列出 J30 时，Orin Nano 归 J30，不算错配"
    },
    {
      "id": "hailo-non-hailo-sku",
      "left": "\\bHailo\\b",
      "right": "(?<![A-Za-z0-9])R2[01]\\d\\d-10(?![\\w-])",
      "severity": "warn",
      "message": "R20xx-10 / R21xx-10 是不带 Hailo 加速器的 SKU；带 Hailo-8 的是 -12 后缀（R2135-12 / R2035-12）"
    }
  ],
