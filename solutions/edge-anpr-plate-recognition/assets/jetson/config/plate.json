{
  "schema": "vb.config/1",
  "device_id": "jetson-plate-gate-a",
  "backend": {
    "name": "trt",
    "model_path": "/models/plate_det_yolox_tiny_640_fp16.engine",
    "input_size": [640, 640],
    "align": "top_left",
    "input": {"color_order": "bgr", "divide": 1.0},
    "decoder": {"type": "yolox", "num_classes": 1, "strides": [8, 16, 32], "grid_center_activation": "none"},
    "options": {}
  },
  "runtime": {"workers": 1, "max_streams_per_worker": 0, "contexts_per_worker": 2, "publishers_per_process": 1,
    "publish_queue": 256, "max_streams": 16, "open_timeout_s": 8.0, "reconnect_delay_s": 1.0, "restart_backoff_s": 5.0},
  "native": {"binary": "/opt/vb/bin/vb-runtime", "hello_timeout_s": 10.0, "snapshot_ring": 24, "jpeg_quality": 85},
  "state_dir": "/data/edge-parking",
  "mqtt": {"host": "r1124.local", "client_id": "jetson-plate-gate-a", "username": "", "password": "", "tls": false, "ca_file": "", "topic_root": "demo-lot/parking/jetson-plate-gate-a", "status_interval_s": 10},
  "health": {"host": "127.0.0.1", "port": 8099},
  "streams_file": "",
  "streams": [{"stream_id": "gate-a", "url": "rtsp://camera.local:554/live", "name": "", "transport": "tcp", "score_threshold": null, "options": {}}],
  "app": {
    "name": "edge-parking-plate",
    "module": "core_parking.config:ParkingApp",
    "options": {
      "site_id": "demo-lot",
      "mqtt": {"host": "r1124.local", "port": 1883, "username": "", "password": "", "keepalive_s": 30},
      "http": {"port": 8080},
      "state_dir": "/data/edge-parking",
      "spool": {"max_events": 50000},
      "preview_frame_stride": 15,
      "plate": {
        "mode": "full",
        "region": "cn",
        "roi": [[0.2, 0.3], [0.8, 0.3], [0.8, 0.95], [0.2, 0.95]],
        "stage2": {"model_path": "/models/plate_rec_cn_96x32_fp16.engine", "input_hw": [32, 96], "classes": [0], "expand": 0.08, "max_per_track": 7, "color": "rgb", "scale": 0.0039215686},
        "vote": {"window": 7, "min_agree": 3, "min_conf": 0.6, "flush_min_agree": 2},
        "dedup_s": 30,
        "snapshot_dir": "/data/edge-parking/snapshots",
        "snapshot_retention_days": 7,
        "snapshot_max_mb": 2048
      }
    }
  }
