# C4 冻结部署的环境变量模板。复制成 .env 后填值。
# .env 已在 .gitignore 里：令牌与口令不入库。
TZ=Asia/Shanghai

# ── 数据库 ──
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=voice
MYSQL_PORT=3306

# ── 对象存储 ──
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 鉴权令牌 ──
# 格式 name:role:token，多条逗号分隔；role 取 viewer|operator|admin。
# 生成方式例：openssl rand -hex 32
#
# voice-service 侧：设备上报用 operator，运维脚本/级联删除用 admin。
VOICE_API_TOKENS=edge-client:operator:<token1>,ops:admin:<token2>
# asr-service 侧：voice-service 级联删除声纹要 admin，客户端识别要 operator。
ASR_API_TOKENS=edge-client:operator:<token3>,voice-service:admin:<token4>
# 客户端自己带的令牌，取上面对应的那一条的值。
VOICE_CLIENT_TOKEN=<token1>
ASR_CLIENT_TOKEN=<token3>

# ── 端口 ──
VOICE_SERVICE_PORT=8081
VOICE_WEB_PORT=3000
CLOUD_ANALYTICS_PORT=8082

# ── 音频采集 ──
AUDIO_CARD_ID=1
AUDIO_DEVICE_ID=0

# ── OVS ──
OVS_PROFILE_DEFAULT=rk3576-default
ASR_PLATFORM=rk3576
OVS_ADMIN_KEY=
# ovs-asr 的内存上限。默认 7500m 是按 8 GB LubanCat 写的；4 GB 级设备（CM4、
# reComputer RK3576 Dev Kit）要下调，否则会被 OOM kill。CM4 采集端预设见
# devices/collector_rerouter.yaml，用的是 3000m/3600m（未在 CM4 上实测，比照同为
# 4 GB 级的 reComputer RK3576 板子取值）。
# OVS_ASR_MEM_LIMIT=7500m
# OVS_ASR_MEMSWAP_LIMIT=7500m
