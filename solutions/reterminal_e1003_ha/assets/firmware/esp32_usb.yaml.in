# Reviewed deployment payload, materialized as devices/e1003_usb.yaml by
# scripts/stage_e1003_candidate.py after the exact firmware hash is checked.
# This template is intentionally not registered as an executable device yet.
version: "1.0"
id: e1003_usb
name: Flash E1003 USB candidate
name_i18n:
  zh: 烧录 E1003 USB 候选固件
type: esp32_usb
detection:
  method: usb_serial
  usb_vendor_id: "0x1a86"
  usb_product_id: "0x7522"
  manual_entry: true
  fallback_ports:
    - /dev/cu.wchusbserial*
    - /dev/ttyUSB*
firmware:
  source:
    path: assets/firmware/firmware.factory.bin
    checksum:
      sha256: 08d616e856cd4d48a0fef0b4e5782e3c4ac1b9efdc1e1647701707bec8bdc540
  flash_config:
    chip: esp32s3
    baud_rate: 115200
    flash_mode: dio
    flash_freq: 80m
    # Keep the built image's 4 MB layout, despite 32 MB physical flash.
    flash_size: 4MB
    partitions:
      - name: factory
        offset: "0x0"
        file: assets/firmware/firmware.factory.bin
steps:
  - id: detect
    name: Detect device
    name_i18n:
      zh: 检测设备
  - id: erase
    name: Full-chip erase (keep disabled; destroys saved configuration)
    name_i18n:
      zh: 全片擦除（保持关闭；会删除已保存配置）
    optional: true
    default: false
  - id: flash
    name: Write factory image
    name_i18n:
      zh: 写入 factory image
  - id: verify
    name: Verify flash write
    name_i18n:
      zh: 校验烧录写入
post_deployment:
  reset_device: true
  wait_for_ready: 10
