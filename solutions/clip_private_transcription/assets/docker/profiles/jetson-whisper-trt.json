{
  "name": "jetson-whisper-trt-base-private",
  "description": "ASR-only Whisper base TensorRT profile. All artifacts are supplied by the mounted approved Jetson bundle.",
  "asr_backend": "jetson.whisper_trt",
  "asr_model_id": "whisper-base",
  "tts_backend": null,
  "env": {
    "ASR_BACKEND": "jetson.whisper_trt",
    "TTS_BACKEND": "",
    "LANGUAGE_MODE": "en",
    "MODEL_DIR": "/models",
    "WHISPER_MODEL_DIR": "/models/whisper",
    "WHISPER_VARIANT": "base",
    "WHISPER_ENCODER_PATH": "/models/whisper/encoder/jetson/enc_base_30s_bf16.plan",
    "WHISPER_DECODER_DIR": "/models/whisper/decoder/base",
    "WHISPER_DECODER_KIND": "tensorrt",
    "WHISPER_DECODER_PREFILL_PLAN": "/models/plans/prefill_fp16.plan",
    "WHISPER_DECODER_STEP_PLAN": "/models/plans/step_fp16.plan",
    "WHISPER_VOCAB_DIR": "/models/whisper",
    "WHISPER_LANGUAGE": "en",
    "WHISPER_WINDOW_S": "30",
    "WHISPER_PADDING_CUTOFF_S": "0",
    "WHISPER_MAX_CONCURRENT": "1",
    "OVS_MAX_CONCURRENT_SESSIONS": "1",
    "OVS_AUTO_DOWNLOAD_ARTIFACTS": "0",
    "OVS_VAD_BACKEND": "none",
    "OVS_PUNCT": "0",
    "OVS_SPEAKER_EMB": "0",
    "OVS_TTS_BACKEND": "none",
    "OVS_TTS_MODEL_ID": "",
    "OVS_MODELS_DIR": "/models",
    "OVS_DATA_DIR": "/var/lib/ovs-whisper/data",
    "OVS_TMP_DIR": "/var/lib/ovs-whisper/tmp",
    "XDG_CACHE_HOME": "/var/cache/ovs-whisper",
    "HF_HOME": "/var/cache/ovs-whisper/hf",
    "HF_HUB_CACHE": "/var/cache/ovs-whisper/hf"
  },
  "asr_max_slots": 1,
  "execution_policy": {"mode": "serialized", "shared_resource": "gpu"},
  "required_engines": []
}
