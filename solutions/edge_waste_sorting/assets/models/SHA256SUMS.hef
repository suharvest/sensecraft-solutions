# Built with DFC 3.31.0 / HailoRT 4.21.0, --hw-arch hailo8.

4e3b9640d0e07aa5ac4235fcadedb8a06ce24568f50c57dcb4dd8bbd0f4aa89e  efficientnet_lite0_waste8_u8.hef
