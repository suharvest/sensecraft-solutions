{
  "engine_path": "/models/yolo11s-pose.sm87.trt10.3.fp16.engine",
  "trt_library": "/app/libjetson_fall_trt.so",
  "temporal_profile": "auto",
  "input": {"width": 640, "height": 640},
  "score_threshold": 0.35,
  "keypoint_threshold": 0.25,
  "nms_threshold": 0.45,
  "max_fps": 15,
