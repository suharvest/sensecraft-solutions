    "cooldown_sec": 3.00
  },
  "mqtt": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 1883,
    "username": "",
    "password": "",
    "topic": "recomputer/fall-detection/results/{stream_id}",
    "keepalive_sec": 30,
    "qos": 0,
    "retain": false,
    "tls": false,
    "ca_file": "",
    "cert_file": "",
    "key_file": ""
  },
  "runtime": {"workers": "auto", "max_streams_per_worker": 7},
  "streams": [
    {
      "id": "cam-01",
      "rtsp_url": "rtsp://192.168.1.64:554/Streaming/Channels/101",
      "enabled": true,
      "reconnect_delay_ms": 1000
    }
  ]
}
